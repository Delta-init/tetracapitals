PORT=4000
MONGO_URI=mongodb://localhost:27017
MONGO_DB=student_tracker
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
# Where people open the portal (frontend) — used for links in reminder emails.
APP_BASE_URL=http://localhost:5173
# Email (follow-up reminders), sent with nodemailer. Zoho Mail example:
#   SMTP_HOST=smtp.zoho.com (org accounts: smtppro.zoho.com; India data centre: smtp.zoho.in / smtppro.zoho.in)
#   SMTP_PORT=465 (SSL) or 587 (STARTTLS)
#   SMTP_USER=the mailbox address, SMTP_PASS=its app-specific password
#   SMTP_FROM=the address mail comes from (Zoho: the mailbox or one of its aliases)
# Leave SMTP_HOST empty and no email is sent (reminders are recorded as not sent).
# Follow-up reminders go out at 10:00 UAE time. FOLLOWUP_REMINDERS=off keeps THIS server
# from sending them (e.g. a laptop pointed at the live database).
FOLLOWUP_REMINDERS=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 3CX: calls with students and their recordings (read-only, every 5 minutes).
# 3CX Admin Console > Integrations > API > Add: a client with "3CX Configuration API Access",
# Role = System Owner; the API key is shown once. Needs an 8SC+ AI licence. Any blank: no call sync.
THREECX_URL=https://deltainstitutions.3cx.ae:5002
THREECX_CLIENT_ID=
THREECX_API_KEY=
# Mentor Calendar: the Delta LMS's service API — the same three values as the Sales CRM's
# backend (it shares the Sales CRM's LMS secret). LMS_API_URL / LMS_SERVICE_SECRET blank: no calendar.
LMS_API_URL=
LMS_SERVICE_SECRET=
LMS_REMOTE_ORG_ID=
ANTHROPIC_API_KEY=

# The Root portal (root-sales-crm), which opens this app for people signed in
# there and manages who has an account here. ROOT_ERP_API_URL is the portal's
# API origin (the same value Media ERP is given); ROOT_ERP_SECRET must equal the
# portal's COMMISSION_SSO_SECRET. Either blank turns that half off.
ROOT_ERP_API_URL=
ROOT_ERP_SECRET=

# Delta finance, which sends each new Delta LMS student here once the LMS has
# them; they go to the teams in turn (team 1, 2, 3, 4, then 1 again) — and its
# accountants' decisions on deposit requests (below). Must equal finance's
# COMMISSION_S2S_SECRET. Blank turns both routes off.
FINANCE_S2S_SECRET=

# Deposit requests approved in Delta finance. Each new DEPOSIT request is sent
# to finance's Approvals, and approved or rejected there; the decision comes
# back on the route above. The same door and credentials the sales CRM and
# Media ERP use: FINANCE_CLIENT_ID / FINANCE_INTEGRATION_SECRET equal finance's
# INBOUND_CLIENT_ID / INBOUND_INTEGRATION_SECRET, and FINANCE_ORG_ID is the
# organization's id there (Delta HQ). Any of the four blank: deposits are
# approved here, as before. Withdrawals and bonuses always are.
FINANCE_API_URL=
FINANCE_CLIENT_ID=
FINANCE_INTEGRATION_SECRET=
FINANCE_ORG_ID=

# The Delta LMS, which sends every other new student (approved sign-ups,
# invited students, store and manual purchases, admin enrolments) — into the
# same round of teams as finance's. Must equal the LMS's COMMISSION_S2S_SECRET.
# Blank turns the route off.
LMS_S2S_SECRET=
