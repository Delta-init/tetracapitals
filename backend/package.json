{
  "name": "student-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Bun + TypeScript + MongoDB backend for the Student Tracker CRM",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "seed": "bun run src/scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "nodemailer": "^6.10.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.1.13",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.1.0",
    "typescript": "^5.6.0"
  }
}
